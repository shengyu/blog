---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listBlogPosts } from "../../lib/blog-post-storage";

const posts = await listBlogPosts();
---

<BaseLayout
  title="Blog | Blog"
  description="Browse published posts in reverse chronological order."
>
  <section class="section-stack">
    <div class="section-heading">
      <p class="eyebrow">Archive</p>
      <h1>Blog posts</h1>
      <p class="lede">
        Posts are loaded through the blog storage layer and rendered at build time.
      </p>
    </div>

    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          <p class="meta">{post.publishDate}</p>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
          <a href={`/blog/${post.slug}/`}>Read the article</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
