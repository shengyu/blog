---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (left, right) =>
    new Date(right.data.publishDate).getTime() -
    new Date(left.data.publishDate).getTime(),
);
---

<BaseLayout
  title="Blog | Blog"
  description="Browse published posts in reverse chronological order."
>
  <section class="section-stack">
    <div class="section-heading">
      <p class="eyebrow">Archive</p>
      <h1>Blog posts</h1>
      <p class="lede">
        Posts are stored in the repository and rendered at build time.
      </p>
    </div>

    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          <p class="meta">{post.data.publishDate}</p>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <a href={`/blog/${post.data.slug}/`}>Read the article</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
