---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listBlogPosts } from "../../lib/blog-post-storage";

function createDisplayDate(value: string) {
  const [year, month, day] = value.split("-").map(Number);

  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(new Date(Date.UTC(year, month - 1, day, 12)));
}

const posts = await listBlogPosts();
---

<BaseLayout
  title="Blog | Blog"
  description="Browse the blog archive in a warm editorial layout with consistent card hierarchy, muted metadata, and long-form reading cues."
>
  <section class="section-stack">
    <div class="section-heading">
      <p class="eyebrow">Reading room archive</p>
      <h1>Browse the published notes</h1>
      <p class="lede">
        Reverse-chronological cards keep discovery calm and readable. The
        archive reuses the same shell, spacing, and accent system as the home
        page and article templates.
      </p>
    </div>

    <div class="card-grid">
      {posts.map((post, index) => (
        <article class={index === 0 ? "card card-featured" : "card"}>
          <p class="meta">{createDisplayDate(post.publishDate)}</p>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
          <a class="card-link" href={`/blog/${post.slug}/`}>Read the article</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
