---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listBlogPosts, loadBlogPost } from "../../lib/blog-post-storage";

export async function getStaticPaths() {
  const posts = await listBlogPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing blog post slug.");
}

const post = await loadBlogPost(slug);

if (!post) {
  throw new Error(`Could not find blog post with slug "${slug}".`);
}

const { Content } = await post.render();
---

<BaseLayout
  title={`${post.title} | Blog`}
  description={post.description}
>
  <article class="post">
    <p class="meta">{post.publishDate}</p>
    <h1>{post.title}</h1>
    <p class="lede">{post.description}</p>
    <Content />
  </article>
</BaseLayout>
