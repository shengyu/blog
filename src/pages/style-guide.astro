---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listBlogPosts } from "../lib/blog-post-storage";

function createDisplayDate(value: string) {
  const [year, month, day] = value.split("-").map(Number);

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(Date.UTC(year, month - 1, day, 12)));
}

const posts = await listBlogPosts();
const featuredPost = posts[0] ?? {
  title: "Modern interface, deliberate reading",
  description: "A modern tech shell, luminous accents, and structured metadata define the site direction.",
  publishDate: "2026-04-01",
};
const archivePreview = posts.length
  ? posts.slice(0, 3)
  : [
      featuredPost,
      {
        title: "Archive cards carry the same panel system",
        description: "Reusable card treatment keeps the archive aligned with the home and article layouts.",
        publishDate: "2026-03-28",
      },
      {
        title: "Metadata stays structured so titles can lead scanning",
        description: "Support details stay crisp and readable without diluting the main hierarchy.",
        publishDate: "2026-03-14",
      },
    ];

const reviewHighlights = [
  {
    title: "Modern tech shell",
    description:
      "Deep contrast, luminous overlays, and glass panels give every page a consistent product-grade frame.",
  },
  {
    title: "Cyan and cobalt accents",
    description:
      "Primary actions stay anchored in cyan, while cobalt supports hierarchy and supporting emphasis.",
  },
  {
    title: "Geometric display hierarchy",
    description:
      "Display typography handles headlines and article titles, while the body stack keeps navigation and long-form copy readable.",
  },
];

const liveRoutes = [
  {
    label: "Home",
    href: "/",
    title: "Homepage",
    description:
      "Validate the reading-room hero, primary action hierarchy, and latest-post handoff.",
  },
  {
    label: "Blog archive",
    href: "/blog/",
    title: "Archive",
    description:
      "Validate repeated card treatment, quiet metadata, and browsing rhythm across the listing page.",
  },
  {
    label: "Post detail",
    href: featuredPost ? `/blog/${featuredPost.slug}/` : "/blog/",
    title: "Article",
    description:
      "Validate immersive article framing, meta panels, and long-form content styling on a real post page.",
  },
];

const componentStates = {
  buttons: [
    { variant: "Primary", class: "button", text: "Primary action" },
    { variant: "Secondary", class: "button button-secondary", text: "Secondary" },
    { variant: "Warm", class: "button button-warm", text: "Warm accent" },
    { variant: "Ghost", class: "button button-ghost", text: "Ghost button" },
    { variant: "Small", class: "button button-sm", text: "Small" },
    { variant: "With icon", class: "button", text: "→ Icon button" },
  ],
  tags: [
    { variant: "Default", class: "tag", text: "Technology" },
    { variant: "Accent", class: "tag tag-accent", text: "Featured" },
    { variant: "Warm", class: "tag tag-warm", text: "Popular" },
    { variant: "Outline", class: "tag tag-outline", text: "Draft" },
  ],
  callouts: [
    { variant: "Info", class: "callout", title: "Information", text: "This is an informational callout for helpful context and tips." },
    { variant: "Success", class: "callout callout-success", title: "Success", text: "Operation completed successfully. Your changes have been saved." },
    { variant: "Warning", class: "callout callout-warning", title: "Warning", text: "Please review your settings before continuing." },
    { variant: "Error", class: "callout callout-error", title: "Error", text: "Something went wrong. Please try again later." },
  ],
  cards: [
    { variant: "Default", class: "card", title: "Standard Card", description: "Default card style used throughout the interface." },
    { variant: "Featured", class: "card card-featured", title: "Featured Card", description: "Highlighted card for important content with accent border." },
    { variant: "Warm", class: "card card-warm", title: "Warm Card", description: "Card with warm accent styling for promotional content." },
    { variant: "Muted", class: "card card-muted", title: "Muted Card", description: "Subdued card style for secondary information." },
  ],
};

const colorTokens = [
  { name: "--color-canvas", value: "#f4efe6", use: "Base page background" },
  { name: "--color-surface", value: "#fffaf2", use: "Solid cards and panels" },
  { name: "--color-ink", value: "#181611", use: "Primary text" },
  { name: "--color-ink-muted", value: "#5b5648", use: "Secondary text" },
  { name: "--color-accent", value: "#0f766e", use: "Primary action color" },
  {
    name: "--color-accent-strong",
    value: "#115e59",
    use: "Hover and active accent states",
  },
  { name: "--color-warm", value: "#c46b45", use: "Supporting emphasis color" },
  { name: "--color-line", value: "rgba(24, 22, 17, 0.12)", use: "Dividers" },
];

const typeTokens = [
  { name: "--text-xs", value: "0.75rem", use: "Labels and metadata" },
  { name: "--text-sm", value: "0.875rem", use: "Small UI text" },
  { name: "--text-base", value: "1rem", use: "Default body text" },
  { name: "--text-lg", value: "1.125rem", use: "Lead copy" },
  { name: "--text-xl", value: "1.25rem", use: "Card titles" },
  { name: "--text-2xl", value: "1.5rem", use: "Section headings" },
  { name: "--text-3xl", value: "2rem", use: "Article headings" },
  { name: "--text-4xl", value: "2.75rem", use: "Page headers" },
  { name: "--text-5xl", value: "3.5rem", use: "Hero headings" },
];

const spacingTokens = [
  { name: "--space-1", value: "0.25rem" },
  { name: "--space-2", value: "0.5rem" },
  { name: "--space-3", value: "0.75rem" },
  { name: "--space-4", value: "1rem" },
  { name: "--space-5", value: "1.5rem" },
  { name: "--space-6", value: "2rem" },
  { name: "--space-7", value: "3rem" },
  { name: "--space-8", value: "4rem" },
  { name: "--space-9", value: "6rem" },
  { name: "--space-10", value: "8rem" },
];

const semanticTokens = [
  { name: "--background", value: "var(--color-canvas)", use: "App background" },
  {
    name: "--surface",
    value: "var(--color-surface-elevated)",
    use: "Translucent panels",
  },
  {
    name: "--surface-strong",
    value: "var(--color-surface)",
    use: "Solid cards",
  },
  { name: "--text", value: "var(--color-ink)", use: "Default foreground" },
  {
    name: "--text-muted",
    value: "var(--color-ink-muted)",
    use: "Secondary copy",
  },
  { name: "--accent", value: "var(--color-accent)", use: "Primary CTA color" },
  {
    name: "--focus-ring",
    value: "0 0 0 3px rgba(15, 118, 110, 0.28)",
    use: "Keyboard focus",
  },
];
---

<BaseLayout
  title="Style guide | Blog"
  description="Reviewable style guide and mockup set for the blog brand, showing the final visual direction across key pages and core components."
>
  <section class="hero">
    <p class="eyebrow">Review artifact</p>
    <h1>Style guide</h1>
    <p class="lede">
      This page packages the approved design decisions into a single review
      surface. It documents the reusable token system and shows the final visual
      direction applied to the home page, archive, post detail page, and core
      interface components.
    </p>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Review checklist</p>
      <h2>How to validate consistency</h2>
    </div>
    <p class="section-description">
      Start on this page for the locked design decisions, then open the live
      routes below to confirm the same visual system appears in production
      templates.
    </p>
    <div class="card-grid">
      {liveRoutes.map((route) => (
        <article class="card">
          <p class="meta">{route.label}</p>
          <h3>{route.title}</h3>
          <p>{route.description}</p>
          <a class="card-link" href={route.href}>Open route</a>
        </article>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Brand direction</p>
      <h2>Locked visual decisions</h2>
    </div>
    <p class="section-description">
      These are the decisions reviewers should see repeated across every page
      mockup and every core component state.
    </p>
    <div class="card-grid">
      {reviewHighlights.map((item, index) => (
        <article class={index === 0 ? "card card-featured" : "card"}>
          <p class="meta">Brand rule {index + 1}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Main pages</p>
      <h2>Applied mockup set</h2>
    </div>
    <p class="section-description">
      Each frame below shows the branded shell, typography, spacing, and core
      components working together on the primary page templates.
    </p>

    <div class="page-mockup-grid">
      <article class="page-mockup">
        <div class="page-mockup-copy">
          <p class="token-chip">Home</p>
          <h3>Landing page with hero and latest post</h3>
          <p>
            The homepage introduces the editorial tone immediately, then hands
            off to the latest story using the shared card language.
          </p>
          <ul class="mockup-notes">
            <li>Shared navigation shell anchors the brand before content.</li>
            <li>Display headline and roomy lead copy establish the reading tone.</li>
            <li>Primary and secondary actions show teal and neutral button hierarchy.</li>
          </ul>
        </div>

        <div class="page-mockup-frame" aria-label="Homepage mockup">
          <div class="page-mockup-bar">
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
          </div>
          <div class="page-mockup-surface">
            <div class="mock-nav">
              <span class="mock-brand">Blog</span>
              <div class="mock-nav-links">
                <span class="mock-nav-pill mock-nav-pill-active">Home</span>
                <span class="mock-nav-pill">Blog</span>
                <span class="mock-nav-pill">Style guide</span>
              </div>
            </div>

            <div class="mock-home-grid">
              <div class="mock-home-hero">
                <p class="eyebrow">Static-first publishing</p>
                <h3>Warm editorial notes for deliberate readers</h3>
                <p>
                  The shell feels atmospheric without competing with the story.
                  Accent color is reserved for the actions that move readers
                  through the site.
                </p>
                <div class="button-row">
                  <span class="button">Browse posts</span>
                  <span class="button button-secondary">Read latest</span>
                </div>
              </div>

              <div class="mock-mini-card">
                <p class="meta">Latest post</p>
                <h4>{featuredPost.title}</h4>
                <p>{featuredPost.description}</p>
                <div class="mock-meta-row">
                  <span class="tag">Featured</span>
                  <span class="mock-meta-chip">
                    {createDisplayDate(featuredPost.publishDate)}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <article class="page-mockup">
        <div class="page-mockup-copy">
          <p class="token-chip">Blog archive</p>
          <h3>Browseable list with consistent card hierarchy</h3>
          <p>
            The archive keeps scanning fast: metadata stays quiet, titles carry
            the rhythm, and cards repeat the same surface treatment used
            elsewhere.
          </p>
          <ul class="mockup-notes">
            <li>Archive heading uses the same serif scale as the homepage.</li>
            <li>Card borders, radius, and shadows match the global surface system.</li>
            <li>Muted metadata supports browsing without overpowering titles.</li>
          </ul>
        </div>

        <div class="page-mockup-frame" aria-label="Archive mockup">
          <div class="page-mockup-bar">
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
          </div>
          <div class="page-mockup-surface">
            <div class="mock-archive-head">
              <p class="eyebrow">Archive</p>
              <h3>Blog posts</h3>
              <p>Reverse-chronological cards keep discovery calm and readable.</p>
            </div>

            <div class="mock-card-grid">
              {archivePreview.map((post, index) => (
                <article class={index === 0 ? "mock-mini-card mock-mini-card-featured" : "mock-mini-card"}>
                  <p class="meta">{createDisplayDate(post.publishDate)}</p>
                  <h4>{post.title}</h4>
                  <div class="mock-lines">
                    <span class="mock-line"></span>
                    <span class="mock-line mock-line-medium"></span>
                    <span class="mock-line mock-line-short"></span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </article>

      <article class="page-mockup">
        <div class="page-mockup-copy">
          <p class="token-chip">Post detail</p>
          <h3>Immersive article layout with measured reading width</h3>
          <p>
            Article pages push the editorial mood furthest: the title sits large
            and close, metadata is surfaced in compact panels, and the prose
            measure stays narrow enough for sustained reading.
          </p>
          <ul class="mockup-notes">
            <li>Large display title creates a strong editorial entry point.</li>
            <li>Meta panels reuse the glass surface treatment from the shell.</li>
            <li>Body copy, blockquotes, and callouts inherit the same spacing rhythm.</li>
          </ul>
        </div>

        <div class="page-mockup-frame" aria-label="Post detail mockup">
          <div class="page-mockup-bar">
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
            <span class="page-mockup-dot"></span>
          </div>
          <div class="page-mockup-surface page-mockup-article">
            <p class="mock-kicker">Reading room</p>
            <h3 class="mock-article-title">{featuredPost.title}</h3>
            <p class="mock-article-lede">{featuredPost.description}</p>

            <div class="mock-meta-row">
              <span class="mock-meta-chip">
                Published {createDisplayDate(featuredPost.publishDate)}
              </span>
              <span class="mock-meta-chip">5 min read</span>
              <span class="mock-meta-chip">1.1K words</span>
            </div>

            <div class="mock-lines">
              <span class="mock-line"></span>
              <span class="mock-line"></span>
              <span class="mock-line mock-line-medium"></span>
              <span class="mock-line"></span>
              <span class="mock-line mock-line-short"></span>
            </div>

            <div class="mock-quote">
              <p>
                The visual system should feel warm and intentional without
                becoming nostalgic or heavy.
              </p>
            </div>

            <div class="mock-lines">
              <span class="mock-line"></span>
              <span class="mock-line"></span>
              <span class="mock-line mock-line-medium"></span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Color palette</p>
      <h2>Primary and secondary colors</h2>
    </div>
    <div class="swatch-grid" aria-label="Color tokens">
      {colorTokens.map((token) => (
        <article class="swatch">
          <div
            class="swatch-color"
            style={`background: ${token.value};`}
            aria-hidden="true"
          />
          <div class="swatch-body">
            <strong>{token.name}</strong>
            <p class="token-value">{token.value}</p>
            <p>{token.use}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Typography</p>
      <h2>Font pairing and scale</h2>
    </div>
    <div class="style-guide-grid columns-2">
      <article class="card">
        <p class="token-chip">Display family</p>
        <h3 style={`font-family: var(--font-display); font-size: var(--text-4xl);`}>
          Editorial headings
        </h3>
        <p>
          <code>--font-display</code> is used for page titles, article headings,
          and other brand-forward moments.
        </p>
      </article>
      <article class="card">
        <p class="token-chip">Body family</p>
        <p style={`font-family: var(--font-body); font-size: var(--text-lg);`}>
          The body stack is a humanist sans that keeps navigation, copy, and UI
          elements readable on every page.
        </p>
      </article>
    </div>

    <div class="token-list" style="margin-top: var(--space-5);">
      {typeTokens.map((token) => (
        <div class="token-row">
          <strong>{token.name}</strong>
          <div class="scale-row" style={`border-bottom: 0; padding: 0;`}>
            <span style={`font-size: ${token.value}; font-family: var(--font-display);`}>
              Aa
            </span>
            <span>{token.value}</span>
            <span>{token.use}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Spacing</p>
      <h2>Geometric spacing scale</h2>
    </div>
    <div class="token-list">
      {spacingTokens.map((token, index) => (
        <div class="token-row">
          <strong>{token.name}</strong>
          <div class="scale-row" style={`border-bottom: 0; padding: 0;`}>
            <span class="space-bar" style={`width: calc(${token.value} * 12);`} />
            <span>{token.value}</span>
            <span>{index === 3 ? "Base unit" : "Layout and component spacing"}</span>
          </div>
        </div>
      ))}
    </div>
    <p style="margin-top: var(--space-4);">
      Use <code>--space-4</code> as the default unit and scale up for layout
      separation, section padding, and roomy containers.
    </p>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Core UI tokens</p>
      <h2>Semantic application values</h2>
    </div>
    <div class="token-list">
      {semanticTokens.map((token) => (
        <div class="token-row">
          <strong>{token.name}</strong>
          <div class="scale-row" style={`border-bottom: 0; padding: 0;`}>
            <span>{token.value}</span>
            <span>{token.use}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Components</p>
      <h2>Buttons</h2>
    </div>
    <p class="section-description">Action buttons with consistent styling across all interaction states.</p>
    <div class="component-showcase">
      {componentStates.buttons.map((btn) => (
        <div class="showcase-item">
          <span class="showcase-label">{btn.variant}</span>
          <button class={btn.class}>{btn.text}</button>
        </div>
      ))}
    </div>
    <div class="showcase-row" style="margin-top: var(--space-6);">
      <div class="showcase-item">
        <span class="showcase-label">Disabled states</span>
        <div class="button-row">
          <button class="button" disabled>Primary disabled</button>
          <button class="button button-secondary" disabled>Secondary disabled</button>
          <button class="button button-ghost" disabled>Ghost disabled</button>
        </div>
      </div>
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Components</p>
      <h2>Tags</h2>
    </div>
    <p class="section-description">Compact labels for categorization and status indication.</p>
    <div class="component-showcase">
      {componentStates.tags.map((tag) => (
        <div class="showcase-item">
          <span class="showcase-label">{tag.variant}</span>
          <span class={tag.class}>{tag.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Components</p>
      <h2>Cards</h2>
    </div>
    <p class="section-description">Content containers with various emphasis levels.</p>
    <div class="card-grid" style="margin-top: var(--space-5);">
      {componentStates.cards.map((card) => (
        <article class={card.class}>
          <p class="meta">Component example</p>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
          <a href="#" class="card-link">Learn more</a>
        </article>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Components</p>
      <h2>Callouts</h2>
    </div>
    <p class="section-description">Attention-grabbing notices for important messages.</p>
    <div class="callout-grid">
      {componentStates.callouts.map((callout) => (
        <div class={callout.class}>
          <div class="callout-header">
            <span class="callout-icon"></span>
            <strong>{callout.title}</strong>
          </div>
          <p>{callout.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">States</p>
      <h2>Empty States</h2>
    </div>
    <p class="section-description">Friendly messaging when there's no content to display.</p>
    <div class="state-showcase-grid">
      <div class="empty-state">
        <div class="empty-state-icon">📝</div>
        <h3>No posts yet</h3>
        <p>Get started by creating your first blog post.</p>
        <button class="button">Create post</button>
      </div>
      <div class="empty-state empty-state-compact">
        <div class="empty-state-icon">🔍</div>
        <h3>No results found</h3>
        <p>Try adjusting your search terms.</p>
        <button class="button button-ghost">Clear filters</button>
      </div>
      <div class="empty-state empty-state-warm">
        <div class="empty-state-icon">✨</div>
        <h3>Coming soon</h3>
        <p>This feature is under development.</p>
        <a href="#">Get notified →</a>
      </div>
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">States</p>
      <h2>Loading States</h2>
    </div>
    <p class="section-description">Visual feedback during asynchronous operations.</p>
    <div class="state-showcase-grid">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading content...</p>
      </div>
      <div class="loading-state loading-state-inline">
        <div class="skeleton skeleton-text" style="width: 60%;"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text" style="width: 80%;"></div>
      </div>
      <div class="loading-state">
        <div class="skeleton skeleton-card"></div>
      </div>
    </div>
  </section>

  <section class="style-guide-panel">
    <div class="section-heading">
      <p class="eyebrow">Patterns</p>
      <h2>Interactive States</h2>
    </div>
    <p class="section-description">Hover, focus, active, and disabled states demonstrated.</p>
    <div class="interactive-grid">
      <div class="interactive-demo">
        <p class="demo-label">Button hover/focus</p>
        <div class="demo-area">
          <button class="button">Hover over me</button>
        </div>
      </div>
      <div class="interactive-demo">
        <p class="demo-label">Card hover</p>
        <div class="demo-area">
          <div class="card card-interactive" style="padding: var(--space-4);">
            <p class="meta">Interactive card</p>
            <p>Hover to see elevation change</p>
          </div>
        </div>
      </div>
      <div class="interactive-demo">
        <p class="demo-label">Link states</p>
        <div class="demo-area">
          <a href="#">Standard link</a>
          <a href="#" class="link-warm">Warm accent link</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
