---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listBlogPosts } from "../lib/blog-post-storage";

const posts = await listBlogPosts();
const latestPost = posts[0];
---

<BaseLayout
  title="Home | Blog"
  description="A static-first Astro blog scaffold with repository-managed posts."
>
  <section class="hero">
    <p class="eyebrow">Static-first publishing</p>
    <h1>Initial blog scaffold</h1>
    <p class="lede">
      This project is ready for Astro page development, Markdown-backed posts,
      and test wiring with Vitest plus Playwright.
    </p>
    <div class="actions">
      <a class="button" href="/blog/">Browse posts</a>
    </div>
  </section>

  {latestPost && (
    <section class="section-stack">
      <div class="section-heading">
        <p class="eyebrow">Latest post</p>
        <h2>{latestPost.title}</h2>
      </div>
      <article class="card">
        <p class="meta">{latestPost.publishDate}</p>
        <p>{latestPost.description}</p>
        <a href={`/blog/${latestPost.slug}/`}>Read the article</a>
      </article>
    </section>
  )}
</BaseLayout>
