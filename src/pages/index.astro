---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listBlogPosts } from "../lib/blog-post-storage";

function createDisplayDate(value: string) {
  const [year, month, day] = value.split("-").map(Number);

  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(new Date(Date.UTC(year, month - 1, day, 12)));
}

const posts = await listBlogPosts();
const latestPost = posts[0];
const recentPosts = posts.slice(1, 4);
---

<BaseLayout
  title="Home | Blog"
  description="A minimalist blog with spacious layouts, refined typography, and elegant reading experience."
>
  <section class="hero hero-home">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Engineering & Design</p>
        <h1>Thoughtful writing on systems, craft, and technology.</h1>
        <p class="lede">
          A spacious blog designed for focused reading. Expansive layouts,
          refined typography, and a sophisticated light gray aesthetic that maximizes
          the available space for an immersive reading experience.
        </p>
        <div class="actions">
          <a class="button" href="/blog/">Browse posts</a>
          <a class="button button-secondary" href="/style-guide/">
            View style guide
          </a>
        </div>
      </div>

      <aside class="hero-panel" aria-label="Site overview">
        <p class="meta">Overview</p>
        <div class="signal-grid">
          <article class="signal-card">
            <p class="signal-label">Published</p>
            <p class="signal-value">{posts.length.toString().padStart(2, "0")}</p>
          </article>
          <article class="signal-card">
            <p class="signal-label">Latest</p>
            <p class="signal-value">{latestPost ? latestPost.publishDate.slice(5) : "N/A"}</p>
          </article>
          <article class="signal-card signal-card-wide">
            <p class="signal-label">Design</p>
            <p class="signal-text">
              Light gray theme with expansive layouts.
            </p>
          </article>
        </div>
      </aside>
    </div>
  </section>

  {latestPost && (
    <section class="section-stack">
      <div class="story-grid">
        <article class="card card-featured">
          <p class="meta">{createDisplayDate(latestPost.publishDate)}</p>
          <p class="card-kicker">Latest Post</p>
          <h2>{latestPost.title}</h2>
          <p>{latestPost.description}</p>
          <a class="card-link" href={`/blog/${latestPost.slug}/`}>Read article</a>
        </article>

        <div class="story-rail">
          <div class="rail-header">
            <p class="eyebrow">Recent</p>
          </div>
          {recentPosts.map((post) => (
            <article class="card card-compact">
              <p class="meta">{createDisplayDate(post.publishDate)}</p>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <a class="card-link" href={`/blog/${post.slug}/`}>Read post</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-stack">
    <div class="section-header-row">
      <div class="section-heading">
        <p class="eyebrow">Navigation</p>
        <h2>Explore the site</h2>
      </div>
      <p class="section-description">
        Three core sections designed for clarity and ease of use.
      </p>
    </div>

    <div class="card-grid card-grid-3">
      <article class="card">
        <p class="meta">01</p>
        <h3>Home</h3>
        <p>Welcome page with featured content and navigation.</p>
        <a class="card-link" href="/">Open homepage</a>
      </article>
      <article class="card">
        <p class="meta">02</p>
        <h3>Blog archive</h3>
        <p>Complete archive of all posts with clean layouts.</p>
        <a class="card-link" href="/blog/">Open archive</a>
      </article>
      <article class="card">
        <p class="meta">03</p>
        <h3>Style guide</h3>
        <p>Design tokens, components, and visual patterns.</p>
        <a class="card-link" href="/style-guide/">Open style guide</a>
      </article>
    </div>
  </section>
</BaseLayout>
